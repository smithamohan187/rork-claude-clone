{
  "expo": {
    "name": "Refer Process V1.0",
    "slug": "refer-process-v10",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.refer-process-v10",
      "infoPlist": {
        "NSContactsUsageDescription": "TouchPoints uses your contacts to help you invite customers to your business. We only access contacts you choose to invite."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.refer_process_v10"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-contacts",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TouchPoints uses your location to show you nearby businesses and pre-fill your city during sign up."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}