{
  "expo": {
    "name": "Touchpoint",
    "slug": "refer-process-v10",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.refer-process-v10",
      "infoPlist": {
        "NSContactsUsageDescription": "TouchPoints uses your contacts to help you invite customers to your business. We only access contacts you choose to invite.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "instagram",
          "fbapi",
          "fb-messenger",
          "twitter"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.refer_process_v10",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "queries": [
        { "package": "com.whatsapp" },
        { "package": "com.instagram.android" },
        { "package": "com.facebook.katana" },
        { "package": "com.twitter.android" }
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "touchpoint-app.com",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "touchpoint-app.com",
              "pathPrefix": "/b/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-contacts",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TouchPoints uses your location to show you nearby businesses and pre-fill your city during sign up."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://rork.com/"
      },
      "eas": {
        "projectId": "996478b8-6fa1-4ffe-9113-5eb29973ccdf"
      }
    }
  }
}
